<?xml version="1.0" encoding="utf-8"?>

<!-- E-Numarası Rehberi ekranı -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5EA">

    <!-- Sayfadaki tüm bileşenleri tutan ana layout -->
    <LinearLayout
        android:id="@+id/layoutAna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Sayfa başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-Numarası Rehberi"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#5F7F2F"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- Kullanıcının katkı maddesi arayabileceği arama kutusu -->
        <EditText
            android:id="@+id/edtENumarasiAra"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Katkı maddesi ara..."
            android:padding="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:fontFamily="sans-serif"
            android:background="#FFFFFF"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:layout_marginBottom="18dp" />

        <!-- Java tarafında oluşturulan E-numarası kartlarının ekleneceği alan -->
        <LinearLayout
            android:id="@+id/layoutENumaralari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>