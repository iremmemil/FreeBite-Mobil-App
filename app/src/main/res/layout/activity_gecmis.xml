<?xml version="1.0" encoding="utf-8"?>

<!-- Kullanıcının sorguladığı ürün geçmişlerini gösteren ekran -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5EA">

    <!-- Sayfadaki tüm bileşenleri tutan ana layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Sayfa başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Geçmişim"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#5F7F2F"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp" />

        <!-- Güvenli olarak değerlendirilen ürünlerin başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Güvenli Ürünler"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#5F7F2F" />

        <!-- Güvenli ürünlerin listeleneceği alan -->
        <TextView
            android:id="@+id/txtGuvenliUrunler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Henüz güvenli ürün yok."
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp" />

        <!-- Riskli olarak değerlendirilen ürünlerin başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Riskli Ürünler"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#B45F06" />

        <!-- Riskli ürünlerin listeleneceği alan -->
        <TextView
            android:id="@+id/txtRiskliUrunler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Henüz riskli ürün yok."
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp" />

        <!-- Ürün geçmişini tamamen temizleyen buton -->
        <Button
            android:id="@+id/btnGecmisiSil"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🗑️ Tüm Geçmişi Sil"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D9534F"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

</ScrollView>